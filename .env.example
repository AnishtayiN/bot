# ===== نمونه فایل .env — آن را به .env تغییر نام دهید و پر کنید =====

# ⚠️ هشدار امنیتی: توکنی که به‌اشتباه در این فایل در گیت‌هاب منتشر شده بود را
#    در @BotFather → /revoke بگیر و توکن جدید را اینجا بگذار.
#    (هر کسی توکن را داشته باشد کنترل کامل ربات را دارد.)

# توکن ربات (از @BotFather) — می‌توانی کل لینک api.telegram.org/bot<TOKEN>/getMe را هم کپی کنی؛ خودش تمیز می‌کند.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی ادمین‌ها (با کاما جدا شوند) — از @userinfobot بگیرید
ADMIN_IDS=123456789

# کانال‌های جوین اجباری پیش‌فرض (اختیاری، با اسپیس جدا شوند؛ بعداً از پنل هم قابل مدیریت است)
FORCE_CHANNELS=

# مسیر فایل کوکی (فرمت Netscape) — کنار bot.py بگذارید
COOKIES_FILE=cookies.txt

# 🔁 جایگزین فایل کوکی برای پلتفرم‌ها/داکر (آپلود فایل ندارند):
# محتوای cookies.txt را base64 کنید و اینجا بگذارید؛ خودکار به cookies.txt تبدیل می‌شود.
#   لینوکس/Mac:  base64 -w0 cookies.txt
#   ویندوز:      certutil -encode cookies.txt out.txt  → محتوای بین BEGIN/END را کپی کنید
COOKIES_B64=

# تنظیمات اختیاری
DOWNLOAD_DIR=downloads
DB_PATH=bot.db
MAX_FILE_MB=48
AUDIO_BITRATE=192
CLEAN_AFTER_MIN=45
JOIN_CACHE_SEC=600
COOLDOWN_SEC=12
SHAZAM_SNIPPET_SEC=95

# زبان پیش‌فرض کاربران: fa | en (هر کاربر با /lang می‌تواند عوض کند)
DEFAULT_LANG=fa

# کانال لاگ خطاها (اختیاری): @channel یا -100... — خطاهای دانلود آنجا گزارش می‌شود
LOG_CHANNEL=

# صف دانلود: حداکثر دانلود همزمان (سوییچ روشن/خاموش در پنل ادمین)
MAX_CONCURRENT_DL=2

# حداکثر آیتم قابل انتخاب از هر پلی‌لیست/ست
PLIST_MAX_ITEMS=25

# =====================================================================
# 🌐 بخش پلتفرم (Railway / VibeNest / Render / Fly / Docker) — همه اختیاری
# =====================================================================
# پلتفرم خودش PORT را ست می‌کند؛ bot.py وب‌سرور وضعیت را روی همان پورت
# بالا می‌آورد. برای دیدن وضعیت: https://<دامنه‌ی سرویس>/health
#
# نکته: PORT/WEB_HOST را فقط اگر لازم است خودت عوض کن؛ پیش‌فرض درست است.
# WEB_HOST=0.0.0.0
# PORT=  ← دست نزن؛ پلتفرم می‌دهد. اگر ندهد روی 3000/8080/8000/5000/80 گوش می‌دهد.

# 🔗 حالت وب‌هوک (اختیاری): اگر آدرس عمومی ربات را اینجا بدهی، به‌جای
#    getUpdates خودِ تلگرام آپدیت‌ها را به همین دامنه POST می‌کند.
#    WEBHOOK_URL=https://bot.vibenest.net
# مسیر وب‌هوک (پیش‌فرض /telegram) و کلید امنیتی (خودکار از توکن ساخته می‌شود)
# WEBHOOK_PATH=telegram
# WEBHOOK_SECRET=

# وب‌هوکِ قدیمیِ ست‌شده روی توکن، حالت polling را با خطای Conflict می‌شکند؛
# این گزینه (پیش‌فرض روشن) موقع راه‌اندازی خودکار پاکش می‌کند.
AUTO_CLEAR_WEBHOOK=1

# 🧦 پروکسی برای ترافیک تلگرام (و yt-dlp). روی سرور ایران لازم است:
#    PROXY_URL=socks5://user:pass@host:port   یا   http://host:port
# (برای socks کتابخانه‌ی socksio در requirements هست.)
PROXY_URL=

# آدرس جایگزین Bot API (سرور محلی یا پروکسی معکوس) — معمولاً خالی
TELEGRAM_API_BASE=

# فاصله‌ی تلاش مجدد اگر راه‌اندازی ربات شکست خورد / چند ثانیه بعد از توقف تمیز زنده بماند
STARTUP_RETRY_SEC=20
STOP_LINGER_SEC=60

# سرور PO-Token (deno) در start.sh:  auto | 1 | 0
#   auto = روی کانتینرهای کم‌حافظه (مثل پلن رایگان ۲۵۶MB) خودکار خاموش می‌شود
POT_SERVER=auto

# ===== یوتیوب / PO-Token (yt-dlp ≥ 2026.08.19) — همه اختیاری =====
# سیاست گرفتن PO Token توسط پلاگین bgutil: never | auto | always (پیش‌فرض: auto)
YTDLP_FETCH_POT=auto
# غیرفعال کردن کامل پلاگین PO-Token بدون حذفش: 1 = خاموش
YTDLP_DISABLE_POT_PLUGIN=
# توکن دستی (بدون پلاگین) — فرمت "CLIENT.CONTEXT+TOKEN" با ویرگول:
#   mweb.gvs+XXXXXXX,web.player=YYYYYYY   (CONTEXT: gvs | player | subs)
YTDLP_PO_TOKEN=
